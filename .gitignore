#include<iostream>
using namespace std;
int binarysearch(int a[],int size,int key ){
    int start=0;
    int end=size-1;
    int mid=(start+end)/2;
       while (start<=end)
       {
        if( a[mid]==key)
        {
            return mid;
        }
        if (key>a[mid])
        {
            start=mid+1;
        }
        
        else
        {
            end=mid-1;
        }
        
        

        mid=(start+end)/2;
       }
       return -1;
}
int main (){
    
int a[5]={2,6,8,10,15};
int key ;
cin>>key;
int index=binarysearch(a,5,key);
cout<<"Key is present "<<index<<endl;

